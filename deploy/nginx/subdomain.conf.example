# Add as a separate host Nginx site. Confirm localhost port 8082 is unused first.
# After testing HTTP routing, issue a certificate using the VPS existing TLS workflow.
server {
    listen 80;
    listen [::]:80;
    server_name kruhub.twiniiz.com;
    server_tokens off;
    client_max_body_size 25m;
    location / {
        proxy_pass http://127.0.0.1:8082;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # A literal upgrade value avoids depending on Keelek's global Nginx map.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 75s;
    }
}
